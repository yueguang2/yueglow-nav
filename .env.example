# 服务
# 本地开发请使用 development；生产部署再设为 production。
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# 持久化
# 本地 Node 运行默认使用 ./data，Docker 中默认使用 /app/data。
DATA_DIR=./data

# 开发环境跨域访问
# NEXT_ALLOWED_DEV_ORIGINS 用于 Next dev 资源白名单，填写 hostname，不带协议和端口。
# NEXT_SERVER_ACTION_ALLOWED_ORIGINS 用于后台表单 Server Actions 白名单，填写 host，可带端口。
# 多个值用英文逗号分隔；修改后需要重启 dev server。
NEXT_ALLOWED_DEV_ORIGINS=
NEXT_SERVER_ACTION_ALLOWED_ORIGINS=

# 懒猫登录
# 默认关闭；设为 true/1/yes/on 后，且 OIDC 配置完整时启用后台懒猫/OIDC 登录。
LAZYCAT_OIDC_LOGIN_ENABLED=false

# OIDC 配置
# 可以使用通用 OIDC_* 变量，也可以使用懒猫注入的 LAZYCAT_AUTH_OIDC_* 变量。
# 两组变量含义相同，按你的部署环境选择一组填写即可。
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
# LAZYCAT_AUTH_OIDC_CLIENT_ID=
# LAZYCAT_AUTH_OIDC_CLIENT_SECRET=
# LAZYCAT_AUTH_OIDC_AUTH_URI=
# LAZYCAT_AUTH_OIDC_TOKEN_URI=
# LAZYCAT_AUTH_OIDC_USERINFO_URI=

# 懒猫/反代域名
# 用于反代场景下生成外部 OIDC 回调地址，按实际部署域名填写。
LAZYCAT_APP_DOMAIN=
APP_BASE_URL=
TRUST_PROXY_HEADERS=false
OIDC_ALLOWED_REDIRECT_HOSTS=
OIDC_ADMIN_ALLOWED_SUBJECTS=
OIDC_ADMIN_ALLOWED_EMAILS=

# 智能链接测速
# 默认只允许客户端跳转内网链接，不让服务器探测内网或未白名单域名。
# 如需服务器测速某些公网域名，请填写 host，多个用英文逗号分隔。
SMART_LINK_PROBE_ALLOWED_HOSTS=

# 懒猫免密/自动填充适配
# 默认关闭；这里只控制应用侧对本地账号密码表单的自动填充适配，不是真正服务端免密 SSO。
LAZYCAT_PASSWORDLESS_LOGIN_ENABLED=false
