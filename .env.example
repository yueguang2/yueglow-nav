# 服务
# 本地开发请使用 development；生产部署再设为 production。
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# 持久化
# 本地 Node 运行默认使用 ./data，Docker 中默认使用 /app/data。
DATA_DIR=./data

# 开发环境跨域访问
# NEXT_ALLOWED_DEV_ORIGINS 用于 Next dev 资源白名单，填写 hostname，不带协议和端口。
# NEXT_SERVER_ACTION_ALLOWED_ORIGINS 用于后台表单 Server Actions 白名单，填写 host，可带端口。
# 多个值用英文逗号分隔；修改后需要重启 dev server。
NEXT_ALLOWED_DEV_ORIGINS=ailab.heiyu.space,192.168.31.177
NEXT_SERVER_ACTION_ALLOWED_ORIGINS=ailab.heiyu.space,ailab.heiyu.space:3000,192.168.31.177,192.168.31.177:3000

# 懒猫登录
# 默认关闭；设为 true/1/yes/on 后，且 OIDC 配置完整时启用后台懒猫/OIDC 登录。
LAZYCAT_OIDC_LOGIN_ENABLED=false

# 懒猫免密/自动填充适配
# 默认关闭；这里只控制应用侧对本地账号密码表单的自动填充适配，不是真正服务端免密 SSO。
LAZYCAT_PASSWORDLESS_LOGIN_ENABLED=false
